{
  "scope": "aux4",
  "name": "json",
  "version": "1.1.1",
  "description": "JSON CLI tools with streaming, pagination, and high performance",
  "license": "Apache-2.0",
  "tags": [
    "aux4",
    "json",
    "stream",
    "pagination"
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "json",
          "execute": [
            "profile:json"
          ],
          "help": {
            "text": "JSON CLI tools with streaming, pagination, and high performance"
          }
        }
      ]
    },
    {
      "name": "json",
      "commands": [
        {
          "name": "get",
          "execute": [
            "stdin:${packageDir}/aux4-json get values(path)"
          ],
          "help": {
            "text": "Extract a value from JSON by path",
            "variables": [
              {
                "name": "path",
                "text": "JSON path (e.g. $.users.0.name)",
                "default": "$",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "pretty",
          "execute": [
            "stdin:${packageDir}/aux4-json pretty"
          ],
          "help": {
            "text": "Pretty-print JSON with indentation"
          }
        },
        {
          "name": "inline",
          "execute": [
            "stdin:${packageDir}/aux4-json inline"
          ],
          "help": {
            "text": "Minify JSON to a single line"
          }
        },
        {
          "name": "index",
          "execute": [
            "stdin:${packageDir}/aux4-json index values(id)"
          ],
          "help": {
            "text": "Index a JSON array by ID field(s)",
            "variables": [
              {
                "name": "id",
                "text": "ID field(s) separated by comma"
              }
            ]
          }
        },
        {
          "name": "group",
          "execute": [
            "stdin:${packageDir}/aux4-json group values(id)"
          ],
          "help": {
            "text": "Group a JSON array by ID field(s)",
            "variables": [
              {
                "name": "id",
                "text": "ID field(s) separated by comma"
              }
            ]
          }
        },
        {
          "name": "collect",
          "execute": [
            "stdin:${packageDir}/aux4-json collect"
          ],
          "help": {
            "text": "Collect NDJSON stream into a JSON array"
          }
        },
        {
          "name": "merge",
          "execute": [
            "${packageDir}/aux4-json merge values(id, files)"
          ],
          "help": {
            "text": "Merge multiple JSON files by ID field(s)",
            "variables": [
              {
                "name": "id",
                "text": "ID field(s) separated by comma"
              },
              {
                "name": "files",
                "text": "JSON files to merge (space-separated)",
                "arg": true
              }
            ]
          }
        },
        {
          "name": "page",
          "execute": [
            "stdin:${packageDir}/aux4-json page values(offset, limit, stream)"
          ],
          "help": {
            "text": "Paginate a JSON array",
            "variables": [
              {
                "name": "offset",
                "text": "Number of items to skip",
                "default": "0"
              },
              {
                "name": "limit",
                "text": "Number of items to return",
                "default": "10"
              },
              {
                "name": "stream",
                "text": "Output as NDJSON stream",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "count",
          "execute": [
            "stdin:${packageDir}/aux4-json count"
          ],
          "help": {
            "text": "Count items in a JSON array"
          }
        },
        {
          "name": "exec",
          "execute": [
            "stdin:${packageDir}/aux4-json exec values(command, ignoreErrors)"
          ],
          "help": {
            "text": "Run a command for each record in a JSON array or NDJSON stream",
            "variables": [
              {
                "name": "command",
                "text": "Command to run per record; use ${item}, ${item.field} and ${index}",
                "arg": true
              },
              {
                "name": "ignoreErrors",
                "text": "Keep going when a command fails instead of stopping",
                "default": "false"
              }
            ]
          }
        },
        {
          "name": "select",
          "execute": [
            "stdin:${packageDir}/aux4-json select values(structure, inputStream)"
          ],
          "help": {
            "text": "Project records to selected fields using the 2table/render field notation",
            "variables": [
              {
                "name": "structure",
                "text": "Fields to keep, e.g. id,name,address[city,country] or source:output to rename",
                "arg": true
              },
              {
                "name": "inputStream",
                "text": "Read NDJSON from stdin and emit one projected object per line",
                "default": "false",
                "options": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        {
          "name": "describe",
          "execute": [
            "stdin:${packageDir}/aux4-json describe values(path, format, maxDepth, sample, values, color)"
          ],
          "help": {
            "text": "Describe the structure (schema) of a JSON document without reading it all",
            "variables": [
              {
                "name": "path",
                "text": "Describe only this sub-path, e.g. $.orders[] where [] means every element",
                "default": "$",
                "arg": true
              },
              {
                "name": "format",
                "text": "Output format",
                "default": "tree",
                "options": [
                  "tree",
                  "paths",
                  "json",
                  "jsonschema",
                  "select"
                ]
              },
              {
                "name": "maxDepth",
                "text": "Stop descending after this many levels; 0 for unlimited",
                "default": "0"
              },
              {
                "name": "sample",
                "text": "Read at most this many array elements or records; 0 for all",
                "default": "0"
              },
              {
                "name": "values",
                "text": "Include example values and enums in the output",
                "default": "true",
                "options": [
                  "true",
                  "false"
                ]
              },
              {
                "name": "color",
                "text": "Colorize the tree and paths output; auto follows CLICOLOR_FORCE and NO_COLOR",
                "default": "auto",
                "options": [
                  "auto",
                  "always",
                  "never"
                ]
              }
            ]
          }
        },
        {
          "name": "peek",
          "execute": [
            "stdin:${packageDir}/aux4-json peek values(path, limit, format)"
          ],
          "help": {
            "text": "Show the first few values at a path without reading the whole document",
            "variables": [
              {
                "name": "path",
                "text": "Peek at this path, e.g. $.orders[] where [] means every element",
                "default": "$",
                "arg": true
              },
              {
                "name": "limit",
                "text": "How many values to show; 0 for all",
                "default": "3"
              },
              {
                "name": "format",
                "text": "Output format; inline emits NDJSON, one value per line",
                "default": "pretty",
                "options": [
                  "pretty",
                  "inline"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
